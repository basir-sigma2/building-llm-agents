# Copy this file to .env and fill in your real values.
#   cp .env.example .env
#
# These names follow the OpenAI SDK convention, so the openai Python
# client picks them up automatically.

# Your Sigma2 AI Gateway API key, issued for your project from the Sigma2 portal.
# Keep it here and nowhere else: don't commit it, paste it into a notebook cell,
# or share it onward.
OPENAI_API_KEY=your-sigma2-token-here

# The Sigma2 AI Gateway base URL (OpenAI-compatible).
OPENAI_BASE_URL=https://ai-gateway.sigma2.no/v1

# Optional: pin a specific model. If unset, the course uses the first chat model
# your project has access to on the endpoint (see notebook 01, which lists them).
# COURSE_MODEL=

# Optional: the decision model used by helpers.decide() (notebook 11).
# COURSE_CLEF_MODEL=clef-flash-not-for-production
